#ضع هنا رمز البوت الخاص بك من BotFather على تليجرام
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# معرف الشات الخاص بك (سيتم التقاطه تلقائياً بمجرد إرسال /start للبوت)
CHAT_ID=

# معدل الفحص بالثواني (600 ثانية = 10 دقائق كما طلبت)
SCAN_INTERVAL_SECONDS=600

# رابط الـ WebApp (اتركه فارغاً للتجربة المحلية أو ضع رابط الاستضافة السحابية)
WEBAPP_URL=https://egypt-black-friday-bot.onrender.com
PORT=8080
